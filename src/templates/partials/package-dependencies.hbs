{{#if packageDependencies}}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">{{t "dependencies" }}</li>
    </ol>
    <table class="table table-sm table-bordered dependencies-table">
        <thead>
            <tr>
                <th>{{t "name" }}</th>
                <th>Version</th>
            </tr>
        </thead>
        <tbody>
            {{#each packageDependencies}}
            <tr>
                <td><b>{{@key}}</b></td>
                <td>{{this}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
{{/if}}

{{#if packagePeerDependencies}}

    {{#if packageDependencies}}
    <br/>
    {{/if}}
    <ol class="breadcrumb">
        <li class="breadcrumb-item">{{t "peer-dependencies" }}</li>
    </ol>
    <table class="table table-sm table-bordered dependencies-table">
        <thead>
            <tr>
                <th>{{t "name" }}</th>
                <th>Version</th>
            </tr>
        </thead>
        <tbody>
            {{#each packagePeerDependencies}}
            <tr>
                <td><b>{{@key}}</b></td>
                <td>{{this}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
{{/if}}
