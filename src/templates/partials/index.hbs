                            <li>
                                <a href="#{{name}}" class="reference-link {{#if deprecated}}deprecated-name{{/if}}"><span class="reference-badge reference-badge--method" aria-hidden="true">M</span><span class="reference-link-label">{{name}}</span></a>
                            </li>
