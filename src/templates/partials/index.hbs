            <tbody>
                <tr>
                    <td class="col-md-3">
                        <h6><b>{{t "hostbindings"}}</b></h6>
                    </td>
                    <td class="col-md-9">
                        <ul class="index-list">
                        {{#each hostBindings}}
                            <li>
