            <tbody>
                <tr>
                    <td class="col-md-3">
                        <h6><b>{{t "accessors" }}</b></h6>
                    </td>
                    <td class="col-md-9">
                        <ul class="index-list">
                        {{#each accessors}}
                            <li>
                                {{#each modifierKind}}
                                    <span class="modifier">{{modifKind this}}</span>
                                {{/each}}
                                <a href="#{{@key}}" class="reference-link {{#if deprecated}}deprecated-name{{/if}}"><span class="reference-badge reference-badge--accessor" aria-hidden="true">A</span><span class="reference-link-label">{{@key}}</span></a>
                            </li>
                        {{/each}}
                        </ul>
                    </td>
                </tr>
            </tbody>
        </table>
        {{/objectLength}}
    {{/if}}
</section>
